# ═══════════════════════════════════════════════════════════════════════════════
# Polymarket BTC Arb Bot — Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.

# ── Polymarket wallet ────────────────────────────────────────────────────────
# Your Ethereum private key (hex, 0x-prefixed). The SDK automatically derives
# API keys from this — no manual API key/secret/passphrase needed.
# For DRY_RUN=true, leave blank or set to any dummy value.
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Polymarket endpoints (defaults are fine) ─────────────────────────────────
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# ── Price feed endpoints (defaults are fine) ─────────────────────────────────
# BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
# COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
# COINGECKO_URL=https://api.coingecko.com/api/v3

# ── Risk management ─────────────────────────────────────────────────────────
MAX_RISK_PER_TRADE=0.005    # 0.5% of balance per trade
DAILY_RISK_CAP=0.02         # 2% daily loss limit → auto-pause
MIN_DIVERGENCE=0.003        # 0.3% minimum divergence to trigger
MAX_POSITION_USD=100.0      # hard cap per position
INITIAL_BALANCE=1000.0      # starting balance for equity tracking

# ── Timing ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=3000       # how often to refresh Polymarket markets
SCAN_INTERVAL_MS=100        # how often to scan for arb signals (~10/sec)

# ── Safety ───────────────────────────────────────────────────────────────────
DRY_RUN=true                # set to false for live trading ⚠
